FROM public.ecr.aws/lambda/python:3.14

# Lint in a clean staging directory so installed packages don't pollute ruff's
# import-section detection.  Packages installed to --target /var/task would
# otherwise appear as local packages alongside aws_exe_sys/ and confuse isort.
RUN python3 -m pip install --no-cache-dir ruff==0.15.7
COPY ruff.toml /src/ruff.toml
COPY aws_exe_sys/ /src/aws_exe_sys/
COPY tests/ /src/tests/
RUN cd /src && ruff check aws_exe_sys/ tests/

# Install dependencies
COPY requirements.txt requirements-test.txt ./
RUN python3 -m pip install -r requirements.txt -r requirements-test.txt --target ${LAMBDA_TASK_ROOT}

# Copy source and tests
COPY aws_exe_sys/ ${LAMBDA_TASK_ROOT}/aws_exe_sys/
COPY tests/ ${LAMBDA_TASK_ROOT}/tests/
COPY infra/02-deploy/step_functions.tf ${LAMBDA_TASK_ROOT}/infra/02-deploy/step_functions.tf
COPY infra/02-deploy/codebuild.tf ${LAMBDA_TASK_ROOT}/infra/02-deploy/codebuild.tf
COPY infra/02-deploy/iam.tf ${LAMBDA_TASK_ROOT}/infra/02-deploy/iam.tf

# Copy CONTRACT.md, CLAUDE.md, and docs/ so contract-drift guards can compare docs to code
COPY CONTRACT.md ${LAMBDA_TASK_ROOT}/CONTRACT.md
COPY CLAUDE.md ${LAMBDA_TASK_ROOT}/CLAUDE.md
COPY docs/ ${LAMBDA_TASK_ROOT}/docs/

ENTRYPOINT ["python3", "-m", "pytest"]
CMD ["tests/unit/", "-v"]
